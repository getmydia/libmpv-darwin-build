+    // Three vsync periods of the display link's screen, at least 0.1 s.
+    // Reads the nominal period directly: currentFps() logs on every call.
+    func swapTimeout() -> TimeInterval {
+        if let link = self.link {
+            let period = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(link)
+            if (period.flags & Int32(CVTimeFlags.isIndefinite.rawValue)) == 0 && period.timeValue > 0 {
+                return max(3 * Double(period.timeValue) / Double(period.timeScale), 0.1)
+            }
+        }
+        return 0.1
+    }
