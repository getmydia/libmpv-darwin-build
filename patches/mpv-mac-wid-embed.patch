+    // Main thread only: caches the embedded view's pixel size and screen for
+    // the VO thread, and keeps the layer's scale in step with the host.
+    func updateEmbedGeometry() {
+        guard let host = embedHost, let view = self.view else { return }
+        layer?.contentsScale = host.window?.backingScaleFactor ?? NSScreen.main?.backingScaleFactor ?? 1
+        let size = view.convertToBacking(view.bounds).size
+        let screen = host.window?.screen
+        embedLock.withLock {
+            embedPixelSize = size
+            embedScreen = screen
+        }
+    }
+
+    // The drawable size in pixels, of the window or of the embedded view.
+    // Never waits on the main thread: it runs on the VO thread while the core
+    // may be blocked on it.
+    @objc func surfacePixelSize() -> CGSize {
+        if let window = window { return window.framePixel.size }
+        return embedLock.withLock { embedPixelSize }
+    }
+
+    // When embedded, the screen is the host window's, not the main screen.
+    override func getCurrentScreen() -> NSScreen? {
+        if window == nil, let screen = embedLock.withLock({ embedScreen }) {
+            return screen
+        }
+        return super.getCurrentScreen()
+    }
